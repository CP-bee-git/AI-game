# Public application settings
APP_ENV=development
APP_NAME=CareerPilot API
API_PREFIX=/api/v1
WEB_ORIGIN=http://localhost:3000

# Storage. `local` works without Docker. Use `s3` in production.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=backend/storage

# Database and queue are reserved for S0/S1 infrastructure.
DATABASE_URL=postgresql+psycopg://careerpilot:careerpilot@localhost:5432/careerpilot
REDIS_URL=redis://localhost:6379/0

# Cloud model provider. Change these values to switch between Qwen and DeepSeek.
MODEL_PROVIDER=qwen
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_MODEL=qwen-plus
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024

# File boundary controls
MAX_UPLOAD_BYTES=10485760
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.png,.jpg,.jpeg

