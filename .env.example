# Optional: leave API key empty and connect it privately from the website.
# Get a Model Studio API key, not an Alibaba Cloud AccessKey ID/Secret.
DASHSCOPE_API_KEY=
QWEN_REGION=china
QWEN_CHAT_MODEL=qwen-plus
QWEN_VISION_MODEL=qwen-vl-plus

APP_ENV=production
LOCAL_STORAGE_DIR=backend/storage/uploads
STATE_DB_PATH=backend/storage/careerpilot.sqlite3
MAX_UPLOAD_BYTES=10485760
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.png,.jpg,.jpeg

# cpolar free account authtoken. Separate from the Qwen API key.
CPOLAR_AUTHTOKEN=

AI_BACKEND=legacy
DIFY_BASE_URL=http://127.0.0.1:8088/v1
DIFY_APP_KEYS_FILE=.private/dify/app-keys.json
DIFY_TIMEOUT_SECONDS=180
CO_WORKER_DB_PATH=/home/w-ubuntu/桌面/co_worker/chat.db
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_PROVIDER=official
BAILIAN_DEEPSEEK_MODEL=deepseek-v4.1-flash
MEDIA_ENABLED=false
ARK_IMAGE_MODEL=
ARK_VIDEO_MODEL=
